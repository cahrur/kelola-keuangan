<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. Lets the WebView reach the Go backend running on the dev
  machine over plain HTTP (http://10.0.2.2:8000 from the emulator). The release
  build never merges this file, so shipped APKs stay HTTPS-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
