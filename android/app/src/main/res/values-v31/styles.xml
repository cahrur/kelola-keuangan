<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ replaces the old starting-window background with the platform splash
  screen, which cannot be disabled. Painting it in the same dark ground as
  SplashScreen.jsx and drawing the same logo at the same size makes it read as the first frame
  of SplashScreen.jsx, instead of an empty dark wait or a second, larger logo.
-->
<resources>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
