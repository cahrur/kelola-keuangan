# === Build config khusus aplikasi Android (Capacitor) ===
# Dipakai oleh: npm run build:native  (vite build --mode native)
#
# Nilai di sini menimpa .env. Salin jadi .env.native lalu isi.

# WAJIB absolut. Di dalam APK, web-nya berjalan di origin https://localhost,
# jadi URL relatif ('' seperti di build web) tidak akan menemukan backend.
VITE_API_URL=https://kelola-keuangan.mudahdeal.com

# WAJIB diisi kalau backend produksi punya TURNSTILE_SECRET_KEY — kalau site key
# kosong, frontend mengirim token kosong dan backend menolak login/register.
# Selain itu, tambahkan hostname "localhost" di Hostname Management widget
# Turnstile, karena di dalam APK halaman berjalan di https://localhost.
VITE_TURNSTILE_SITE_KEY=

# Web Client ID (nilai publik, sama dengan yang dipakai versi web). Credential
# Manager memakainya sebagai webClientId, dan token yang dihasilkan ber-aud sama
# sehingga lolos pemeriksaan di google_auth.go. Butuh OAuth client bertipe
# Android terdaftar di Cloud Console — lihat bagian Android di README.
VITE_GOOGLE_CLIENT_ID=
